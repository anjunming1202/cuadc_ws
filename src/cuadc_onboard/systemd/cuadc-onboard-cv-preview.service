[Unit]
Description=cuadc_onboard CV preview (raw shm -> color_pad boxes -> 5604)
# Step 2: color_pad detect @10fps, draw circles + per-frame ms tracker.
# Reads camera-service raw NV12 shm; does not open the camera.
After=cuadc-onboard-camera.service
Wants=cuadc-onboard-camera.service

[Service]
Type=simple
User=wly
Environment=GST_PLUGIN_PATH=/usr/local/lib/aarch64-linux-gnu/gstreamer-1.0
Environment=CUADC_PERCEPTION_ROOT=/home/wly/cuadc_ws/src/cuadc_perception
Environment=PYTHONPATH=/home/wly/cuadc_ws/src/cuadc_perception
ExecStart=/usr/bin/python3 /opt/cuadc-onboard/cv_preview.py --raw-shm /tmp/cuadc-cam-raw.shm --src-width 1920 --src-height 1080 --src-fps 10 --dst-port 5604 --width 960 --height 540 --bitrate 1000 --profile real
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
