[Unit]
Description=cuadc_onboard CV preview (raw shm -> labeled H264 -> 5604)
# Reads camera-service raw NV12 shm @10fps (no H264 decode); does not open camera.
After=cuadc-onboard-camera.service
Wants=cuadc-onboard-camera.service

[Service]
Type=simple
User=wly
Environment=GST_PLUGIN_PATH=/usr/local/lib/aarch64-linux-gnu/gstreamer-1.0
ExecStart=/usr/bin/python3 /opt/cuadc-onboard/cv_preview.py --raw-shm /tmp/cuadc-cam-raw.shm --src-width 1920 --src-height 1080 --src-fps 10 --dst-port 5604 --width 960 --height 540 --bitrate 1000 --label "OpenCV processed"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
