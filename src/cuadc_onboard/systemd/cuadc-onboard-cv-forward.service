[Unit]
Description=cuadc_onboard CV video forward (local 5604 -> ground 5606)
# Second downlink path; original clean video stays on video-forward 5603->5600.
After=cuadc-onboard-cv-preview.service
Wants=cuadc-onboard-cv-preview.service

[Service]
Type=simple
User=wly
ExecStart=/usr/bin/gst-launch-1.0 udpsrc port=5604 ! udpsink host=192.168.50.2 port=5606 sync=false async=false
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
