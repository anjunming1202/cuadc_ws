<?xml version="1.0"?>
<model>
  <name>cuadc_iris</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    CUADC 仿真机体：vendored 自 ardupilot_gazebo 的 iris_with_gimbal，按真机注入
    保真度（质量/质心/推力，后续相机偏置/物理水瓶）。改动依据见
    docs/spec/adr/0010-sim-fidelity-airframe-model.md。外部 iris_with_standoffs /
    gimbal_small_3d 仍从 ardupilot_gazebo 引入（机架网格/相机链不改）。
  </description>
</model>
