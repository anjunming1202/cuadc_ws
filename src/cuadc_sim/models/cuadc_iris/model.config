<?xml version="1.0"?>
<model>
  <name>cuadc_iris</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    CUADC 仿真机体：按真机实测建模（545mm 轴距 / 15in 桨 / 飞控离地 0.31m /
    满载 3.5kg / 可分离水瓶）。数值与依据见
    docs/spec/adr/0010-sim-fidelity-airframe-model.md。相机 = 硬支架固定 nadir
    （同真机，前0.11/下0.20，内参对齐真机标定）。仍从 ardupilot_gazebo 引入的
    外部件：桨网格（iris_with_standoffs/meshes）。
  </description>
</model>
