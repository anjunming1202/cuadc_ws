[Unit]
Description=DroneLink MAVLink telemetry UDP to ground
After=dronelink-network.service
Wants=dronelink-network.service

[Service]
Type=simple
User=wly
# Start immediately; the script sends UDP while waiting for the FC.
ExecStart=/home/wly/dronelink-venv/bin/python3 /usr/local/sbin/dronelink-telemetry.py --device /dev/ttyAMA0 --baud 57600 --dest-host 192.168.50.2,10.10.10.2 --dest-ports 5701,5601 --hz 10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
