[Unit]
Description=DroneLink MAVLink telemetry UDP to ground
# Wait for AP so first UDP packets have a route; FC may still be booting — script retries.
After=dronelink-network.service
Wants=dronelink-network.service

[Service]
Type=simple
User=wly
# Give USB-serial / FC a few seconds after multi-user boot (undervoltage reboots are slow).
ExecStartPre=/bin/sleep 8
ExecStart=/home/wly/dronelink-venv/bin/python3 /usr/local/sbin/dronelink-telemetry.py --device /dev/ttyAMA0 --baud 57600 --dest-host 192.168.50.2,10.10.10.2 --dest-port 5701 --hz 10
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
